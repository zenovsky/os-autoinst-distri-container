#!/usr/bin/env perl

use strict;
use warnings;

use FindBin '$Bin';
use Getopt::Long qw(GetOptions);
use JSON::PP qw(decode_json);

use lib "$Bin/../lib";

use ScenarioLoader;

# ------------------------------------------------------------
# Defaults
# ------------------------------------------------------------

my %opt = (
    host => 'http://localhost',
    poll => 10,
);

# ------------------------------------------------------------
# CLI
# ------------------------------------------------------------

my $scenario_name = shift @ARGV
    // die "Usage: $0 <scenario> [options]\n";

GetOptions(
    'host=s'     => \$opt{host},
    'distri=s'   => \$opt{distri},
    'version=s'  => \$opt{version},
    'build=s'    => \$opt{build},
    'flavor=s'   => \$opt{flavor},
    'arch=s'     => \$opt{arch},
    'machine=s'  => \$opt{machine},
    'iso=s'      => \$opt{iso},
    'iso-url=s'  => \$opt{iso_url},
    'casedir=s'  => \$opt{casedir},
    'hdd=s'      => \$opt{hdd},
    'poll=i'     => \$opt{poll},
    'help'       => \$opt{help},
) or die "Invalid options\n";

if ($opt{help}) {
    print_usage();
    exit 0;
}

die "--poll must be greater than 0\n"
    if $opt{poll} <= 0;

# ------------------------------------------------------------
# Common options
# ------------------------------------------------------------

require_option('distri');
require_option('version');
require_option('flavor');
require_option('arch');
require_option('machine');
require_option('iso');
require_option('casedir');
require_option('build');

# ------------------------------------------------------------
# Run requested scenario
# ------------------------------------------------------------

my $result =
    run_scenario($scenario_name);

exit(
    $result ? 0 : 1
);

# ============================================================
# Run scenario
# ============================================================

sub run_scenario {
    my ($name, %args) = @_;

    my $hdd = $args{hdd};

    my $loader = ScenarioLoader->new(
        scenario_dir => "$Bin/../scenarios"
    );

    my $scenario =
        $loader->load($name);

    print "Scenario: $scenario->{name}\n";
    print "Type:     $scenario->{type}\n";

    #
    # VERIFY
    #

    if ($scenario->{type} eq 'verify') {

        return run_verify_scenario(
            $name,
            $scenario,
        );
    }

    #
    # PARALLEL
    #

    if ($scenario->{type} eq 'parallel') {

        return run_parallel_scenario(
            $name,
            $scenario,
        );
    }

    #
    # TEST / IMAGE
    #

    my %job = build_common_job(
        $name,
        $scenario,
    );

    #
    # Existing HDD
    #

    if (
        $scenario->{type} eq 'test'
        && defined $hdd
        && length $hdd
    ) {

        $job{BOOT_HDD_IMAGE} = 1;
        $job{HDD_1} = $hdd;

        print "HDD:\n";
        print "  Image: $hdd\n";
    }

    #
    # IMAGE
    #

    my $expected_image;

    if ($scenario->{type} eq 'image') {

        my $image =
            $scenario->{image};

        my $image_size =
            $image->{size_gb};

        $expected_image =
            expand_variables(
                $image->{name},
                \%job
            );

        print "Image:\n";
        print "  Name: $expected_image\n";
        print "  Size: ${image_size} GB\n";

        $job{HDDSIZEGB} =
            $image_size;

        $job{PUBLISH_HDD_1} =
            $expected_image;
    }

    #
    # Expand
    #

    expand_job_variables(
        \%job
    );

    #
    # Print
    #

    print "\nJob parameters:\n";

    print_job_parameters(
        \%job
    );

    #
    # Submit
    #

    print "\nStarting openQA job...\n";

    my @command = (
        'openqa-cli',
        'api',
        '-X',
        'POST',
        'jobs',
    );

    for my $key (
        sort keys %job
    ) {

        push @command,
            "$key=$job{$key}";
    }

    my $response =
        capture_command(
            @command
        );

    my $data =
        decode_json($response);

    die "openQA response does not contain job id\n"
        unless exists $data->{id};

    my $job_id =
        $data->{id};

    print "Job ID: $job_id\n";

    #
    # Wait
    #

    wait_for_job(
        $job_id
    );

    #
    # Final information
    #

    my $job_data =
        get_job($job_id);

    my $job_result =
        $job_data->{job}->{result};

    my $job_state =
        $job_data->{job}->{state};

    print "\nJob finished.\n";
    print "  ID:     $job_id\n";
    print "  State:  $job_state\n";
    print "  Result: "
        . ($job_result // 'none')
        . "\n";

    unless (
        defined $job_result
        && $job_result eq 'passed'
    ) {

        print "\nScenario '$name' failed.\n";

        return;
    }

    #
    # Verify published image
    #

    if ($scenario->{type} eq 'image') {

        my $hdds =
            $job_data->{job}->{assets}->{hdd}
            // [];

        my %published =
            map {
                $_ => 1
            } @{$hdds};

        unless (
            $published{$expected_image}
        ) {

            print "\nERROR: Expected HDD was not published:\n";
            print "  $expected_image\n";

            print "\nPublished HDD assets:\n";

            for my $hdd_name (
                @{$hdds}
            ) {

                print "  $hdd_name\n";
            }

            return;
        }

        print "\nImage successfully created:\n";
        print "  $expected_image\n";

        return $expected_image;
    }

    print "\nScenario '$name' passed.\n";

    return 1;
}

# ============================================================
# Build common job
# ============================================================

sub build_common_job {
    my ($name, $scenario) = @_;

    my %job = (
        DISTRI  => $opt{distri},
        VERSION => $opt{version},
        BUILD   => $opt{build},
        FLAVOR  => $opt{flavor},
        ARCH    => $opt{arch},
        MACHINE => $opt{machine},
        BACKEND => 'qemu',
        ISO     => $opt{iso},
        CASEDIR => $opt{casedir},

        TEST     => $name,
        SCENARIO => $name,
    );

    if (
        defined $opt{iso_url}
        && length $opt{iso_url}
    ) {

        $job{ISO_URL} =
            $opt{iso_url};
    }

    #
    # Scenario variables
    #

    for my $key (
        keys %{$scenario->{variables} // {}}
    ) {

        $job{$key} =
            $scenario->{variables}{$key};
    }

    expand_job_variables(
        \%job
    );

    return %job;
}

# ============================================================
# Expand job variables
# ============================================================

sub expand_job_variables {
    my ($job) = @_;

    for my $key (
        keys %{$job}
    ) {

        $job->{$key} =
            expand_variables(
                $job->{$key},
                $job
            );
    }

    #
    # Second pass because variables can depend
    # on variables defined in the first pass.
    #

    for my $key (
        keys %{$job}
    ) {

        $job->{$key} =
            expand_variables(
                $job->{$key},
                $job
            );
    }
}

# ============================================================
# Run VERIFY scenario
# ============================================================

sub run_verify_scenario {
    my ($name, $scenario) = @_;

    print "\n";
    print "============================================================\n";
    print "VERIFY SCENARIO: $name\n";
    print "============================================================\n";

    my $loader =
        ScenarioLoader->new(
            scenario_dir => "$Bin/../scenarios"
        );

    my @stages =
        @{$scenario->{stages}};

    #
    # Stage name -> stage index
    #

    my %stage_index;

    for my $index (
        0 .. $#stages
    ) {

        my $stage_name =
            $stages[$index]->{name};

        $stage_index{$stage_name} =
            $index;
    }

    #
    # Build one flat list of openQA jobs.
    #
    # Each verify stage may expand to:
    #
    #   image    -> 1 job
    #   test     -> 1 job
    #   parallel -> N jobs
    #

    my @jobs;

    #
    # stage name -> list of generated job indexes
    #

    my %stage_jobs;

    #
    # Image generated by image stage.
    #

    my $verify_image;

    for my $stage_index (
        0 .. $#stages
    ) {

        my $stage =
            $stages[$stage_index];

        my $stage_name =
            $stage->{name};

        my $type =
            $stage->{type};

        my $scenario_name =
            $stage->{scenario};

        my $child_scenario =
            $loader->load(
                $scenario_name
            );

        #
        # ----------------------------------------------------
        # IMAGE
        # ----------------------------------------------------
        #

        if ($type eq 'image') {

            my %job =
                build_common_job(
                    $stage_name,
                    $child_scenario,
                );

            #
            # Image configuration
            #

            my $image =
                $child_scenario->{image};

            my $expected_image =
                expand_variables(
                    $image->{name},
                    \%job
                );

            $job{HDDSIZEGB} =
                $image->{size_gb};

            $job{PUBLISH_HDD_1} =
                $expected_image;

            #
            # Remember image for downstream stages.
            #

            $verify_image =
                $expected_image;

            #
            # Register job
            #

            my $index =
                scalar @jobs;

            $job{TEST} =
                $stage_name;

            $job{SCENARIO} =
                $scenario_name;

            $jobs[$index] = {
                index => $index,
                name  => $stage_name,
                type  => 'image',
                stage => $stage_name,
                params => \%job,
            };

            $stage_jobs{$stage_name} =
                [$index];

            next;
        }

        #
        # ----------------------------------------------------
        # TEST
        # ----------------------------------------------------
        #

        if ($type eq 'test') {

            my %job =
                build_common_job(
                    $stage_name,
                    $child_scenario,
                );

            $job{TEST} =
                $stage_name;

            $job{SCENARIO} =
                $scenario_name;

            #
            # If image stage exists, use its HDD.
            #

            if (
                defined $verify_image
                && length $verify_image
            ) {

                $job{BOOT_HDD_IMAGE} = 1;
                $job{HDD_1} =
                    $verify_image;
            }

            my $index =
                scalar @jobs;

            $jobs[$index] = {
                index => $index,
                name  => $stage_name,
                type  => 'test',
                stage => $stage_name,
                params => \%job,
            };

            $stage_jobs{$stage_name} =
                [$index];

            next;
        }

        #
        # ----------------------------------------------------
        # PARALLEL
        # ----------------------------------------------------
        #

        if ($type eq 'parallel') {

            my @parallel_jobs =
                @{$child_scenario->{jobs}};

            my %parallel_index;

            #
            # Local parallel job name -> global job index
            #

            for my $parallel_job (
                @parallel_jobs
            ) {

                my $parallel_name =
                    $parallel_job->{name};

                my $index =
                    scalar @jobs;

                $parallel_index{$parallel_name} =
                    $index;

                my %job =
                    build_common_job(
                        $parallel_name,
                        $child_scenario,
                    );

                $job{TEST} =
                    $parallel_name;

                $job{SCENARIO} =
                    $scenario_name;

                $job{PARALLEL_JOB} =
                    $parallel_name;

                #
                # Existing verify image
                #

                if (
                    defined $verify_image
                    && length $verify_image
                ) {

                    $job{BOOT_HDD_IMAGE} = 1;
                    $job{HDD_1} =
                        $verify_image;
                }

                $jobs[$index] = {
                    index => $index,
                    name  => $parallel_name,
                    type  => 'parallel',
                    stage => $stage_name,
                    params => \%job,

                    #
                    # Save local dependency.
                    #

                    parallel_with =>
                        $parallel_job->{PARALLEL_WITH},
                };

                push @{$stage_jobs{$stage_name}},
                    $index;
            }

            #
            # Resolve local PARALLEL_WITH.
            #

            for my $parallel_job (
                @parallel_jobs
            ) {

                next
                    unless exists
                    $parallel_job->{PARALLEL_WITH};

                my $job_name =
                    $parallel_job->{name};

                my $target =
                    $parallel_job->{PARALLEL_WITH};

                die "Parallel job '$job_name' in verify "
                    . "stage '$stage_name' references "
                    . "unknown job '$target'\n"
                    unless exists
                    $parallel_index{$target};

                my $global_index =
                    $parallel_index{$job_name};

                my $target_index =
                    $parallel_index{$target};

                $jobs[$global_index]->{parallel_with_index} =
                    $target_index;
            }

            next;
        }
    }

    #
    # --------------------------------------------------------
    # Resolve START_AFTER_TEST
    # --------------------------------------------------------
    #

    for my $stage (
        @stages
    ) {

        next
            unless exists
            $stage->{START_AFTER_TEST};

        my @targets;

        if (
            ref($stage->{START_AFTER_TEST})
            eq 'ARRAY'
        ) {

            @targets =
                @{$stage->{START_AFTER_TEST}};
        }
        else {

            @targets =
                ($stage->{START_AFTER_TEST});
        }

        my @parent_indexes;

        for my $target (
            @targets
        ) {

            die "Unknown START_AFTER_TEST target "
                . "'$target'\n"
                unless exists
                $stage_jobs{$target};

            push @parent_indexes,
                @{$stage_jobs{$target}};
        }

        #
        # Every job in this stage waits for
        # every job generated by parent stages.
        #

        for my $job_index (
            @{$stage_jobs{$stage->{name}}}
        ) {

            $jobs[$job_index]->{start_after} =
                [@parent_indexes];
        }
    }

    #
    # --------------------------------------------------------
    # Print scenario graph
    # --------------------------------------------------------
    #

    print "\n";
    print "Verify dependency graph:\n";

    for my $job (
        @jobs
    ) {

        print "\n";
        print "  [$job->{index}] $job->{name}";
        print " ($job->{type})";

        if (
            exists $job->{start_after}
            && @{$job->{start_after}}
        ) {

            print "\n";
            print "      START_AFTER_TEST: ";

            print join(
                ',',
                @{$job->{start_after}}
            );
        }

        if (
            exists $job->{parallel_with_index}
        ) {

            print "\n";
            print "      PARALLEL_WITH: "
                . $job->{parallel_with_index};
        }
    }

    #
    # --------------------------------------------------------
    # Build ONE POST /jobs request
    # --------------------------------------------------------
    #

    my @command = (
        'openqa-cli',
        'api',
        '-X',
        'POST',
        'jobs',
    );

    for my $job (
        @jobs
    ) {

        my $index =
            $job->{index};

        #
        # Job parameters
        #

        for my $key (
            sort keys %{$job->{params}}
        ) {

            my $value =
                $job->{params}{$key};

            next
                unless defined $value;

            push @command,
                "$key:$index=$value";
        }

        #
        # START_AFTER
        #

        if (
            exists $job->{start_after}
            && @{$job->{start_after}}
        ) {

            my $value =
                join(
                    ',',
                    @{$job->{start_after}}
                );

            push @command,
                "_START_AFTER:$index=$value";
        }

        #
        # PARALLEL
        #

        if (
            exists $job->{parallel_with_index}
        ) {

            push @command,
                "_PARALLEL:$index="
                . $job->{parallel_with_index};
        }
    }

    #
    # --------------------------------------------------------
    # Print request
    # --------------------------------------------------------
    #

    print "\n";
    print "\n";
    print "============================================================\n";
    print "Submitting VERIFY jobs in ONE request\n";
    print "============================================================\n";

    print "\nCommand parameters:\n";

    for my $arg (
        @command[5 .. $#command]
    ) {

        print "  $arg\n";
    }

    #
    # --------------------------------------------------------
    # Submit
    # --------------------------------------------------------
    #

    print "\nStarting verify jobs...\n";

    my $response =
        capture_command(
            @command
        );

    print "\nopenQA response:\n";
    print $response;

    my $data =
        decode_json($response);

    die "openQA response does not contain job IDs\n"
        unless exists $data->{ids}
        && ref($data->{ids}) eq 'HASH';

    #
    # --------------------------------------------------------
    # Save IDs
    # --------------------------------------------------------
    #

    my %job_ids;

    for my $index (
        keys %{$data->{ids}}
    ) {

        die "Invalid job index returned by openQA: $index\n"
            unless exists $jobs[$index];

        my $job_name =
            $jobs[$index]->{name};

        my $job_id =
            $data->{ids}{$index};

        $job_ids{$index} =
            $job_id;

        print "  [$index] $job_name -> job $job_id\n";
    }

    #
    # Verify all jobs got IDs.
    #

    for my $job (
        @jobs
    ) {

        my $index =
            $job->{index};

        die "openQA did not return job ID for "
            . "'$job->{name}'\n"
            unless exists
            $job_ids{$index};
    }

    #
    # --------------------------------------------------------
    # Wait
    # --------------------------------------------------------
    #

    print "\n";
    print "============================================================\n";
    print "Waiting for verify jobs\n";
    print "============================================================\n";

    my $failed = 0;

    for my $job (
        @jobs
    ) {

        my $index =
            $job->{index};

        my $job_id =
            $job_ids{$index};

        print "\n";
        print "Waiting for '$job->{name}' "
            . "(ID $job_id)...\n";

        wait_for_job(
            $job_id
        );

        my $job_data =
            get_job($job_id);

        my $state =
            $job_data->{job}->{state}
            // 'unknown';

        my $result =
            $job_data->{job}->{result};

        print "\n";
        print "Job finished.\n";
        print "  Name:   $job->{name}\n";
        print "  ID:     $job_id\n";
        print "  State:  $state\n";
        print "  Result: "
            . ($result // 'none')
            . "\n";

        unless (
            defined $result
            && $result eq 'passed'
        ) {

            $failed = 1;
        }
    }

    #
    # --------------------------------------------------------
    # Result
    # --------------------------------------------------------
    #

    print "\n";
    print "============================================================\n";
    print "VERIFY RESULTS\n";
    print "============================================================\n";

    for my $job (
        @jobs
    ) {

        my $index =
            $job->{index};

        my $job_id =
            $job_ids{$index};

        my $job_data =
            get_job($job_id);

        my $result =
            $job_data->{job}->{result};

        print "  $job->{name} "
            . "(job $job_id): "
            . ($result // 'none')
            . "\n";
    }

    if ($failed) {

        print "\n";
        print "============================================================\n";
        print "VERIFY FAILED\n";
        print "============================================================\n";

        return;
    }

    print "\n";
    print "============================================================\n";
    print "VERIFY PASSED\n";
    print "============================================================\n";

    return 1;
}

# ============================================================
# Run parallel scenario
# ============================================================

sub run_parallel_scenario {
    my ($name, $scenario) = @_;

    print "\n";
    print "============================================================\n";
    print "PARALLEL SCENARIO: $name\n";
    print "============================================================\n";

    my @parallel_jobs =
        @{$scenario->{jobs}};

    #
    # Job name -> index
    #

    my %job_index;

    for my $index (
        0 .. $#parallel_jobs
    ) {

        $job_index{
            $parallel_jobs[$index]->{name}
        } = $index;
    }

    #
    # ONE POST /jobs
    #

    my @command = (
        'openqa-cli',
        'api',
        '-X',
        'POST',
        'jobs',
    );

    #
    # Common parameters
    #

    my %common = (
        DISTRI  => $opt{distri},
        VERSION => $opt{version},
        BUILD   => $opt{build},
        FLAVOR  => $opt{flavor},
        ARCH    => $opt{arch},
        MACHINE => $opt{machine},
        BACKEND => 'qemu',
        ISO     => $opt{iso},
        CASEDIR => $opt{casedir},
        SCENARIO => $name,
    );

    if (
        defined $opt{iso_url}
        && length $opt{iso_url}
    ) {

        $common{ISO_URL} =
            $opt{iso_url};
    }

    #
    # Scenario variables
    #

    for my $key (
        keys %{$scenario->{variables} // {}}
    ) {

        $common{$key} =
            $scenario->{variables}{$key};
    }

    expand_job_variables(
        \%common
    );

    #
    # Build jobs
    #

    for my $index (
        0 .. $#parallel_jobs
    ) {

        my $parallel_job =
            $parallel_jobs[$index];

        my $job_name =
            $parallel_job->{name};

        print "\n";
        print "------------------------------------------------------------\n";
        print "Parallel job [$index]: $job_name\n";
        print "------------------------------------------------------------\n";

        push @command,
            "TEST:$index=$job_name";

        print "  TEST:$index=$job_name\n";

        push @command,
            "PARALLEL_JOB:$index=$job_name";

        print "  PARALLEL_JOB:$index=$job_name\n";

        for my $key (
            sort keys %common
        ) {

            next
                if $key eq 'SCENARIO';

            my $value =
                $common{$key};

            next
                unless defined $value;

            push @command,
                "$key:$index=$value";
        }

        push @command,
            "SCENARIO:$index=$name";

        #
        # _PARALLEL
        #

        if (
            exists
            $parallel_job->{PARALLEL_WITH}
        ) {

            my $target_name =
                $parallel_job->{PARALLEL_WITH};

            die "Parallel job '$job_name' references "
                . "unknown job '$target_name'\n"
                unless exists
                $job_index{$target_name};

            my $target_index =
                $job_index{$target_name};

            push @command,
                "_PARALLEL:$index=$target_index";

            print "  _PARALLEL:$index=$target_index\n";
        }
    }

    #
    # Print
    #

    print "\n";
    print "============================================================\n";
    print "Submitting ALL parallel jobs in ONE request\n";
    print "============================================================\n";

    print "\nCommand parameters:\n";

    for my $arg (
        @command[5 .. $#command]
    ) {

        print "  $arg\n";
    }

    #
    # Submit
    #

    print "\nStarting parallel jobs...\n";

    my $response =
        capture_command(
            @command
        );

    print "\nopenQA response:\n";
    print $response;

    my $data =
        decode_json($response);

    die "openQA response does not contain job IDs\n"
        unless exists $data->{ids}
        && ref($data->{ids}) eq 'HASH';

    #
    # IDs
    #

    my %job_ids;

    for my $index (
        keys %{$data->{ids}}
    ) {

        die "Invalid job index returned by openQA: $index\n"
            unless exists
            $parallel_jobs[$index];

        my $job_name =
            $parallel_jobs[$index]->{name};

        my $job_id =
            $data->{ids}{$index};

        $job_ids{$job_name} =
            $job_id;

        print "  $job_name -> job $job_id\n";
    }

    #
    # Verify IDs
    #

    for my $index (
        0 .. $#parallel_jobs
    ) {

        my $job_name =
            $parallel_jobs[$index]->{name};

        die "openQA did not return job ID for "
            . "'$job_name'\n"
            unless exists
            $job_ids{$job_name};
    }

    #
    # Wait
    #

    my %job_results;

    print "\n";
    print "============================================================\n";
    print "Waiting for parallel jobs\n";
    print "============================================================\n";

    for my $parallel_job (
        @parallel_jobs
    ) {

        my $job_name =
            $parallel_job->{name};

        my $job_id =
            $job_ids{$job_name};

        print "\n";
        print "Waiting for job '$job_name' "
            . "(ID $job_id)...\n";

        wait_for_job(
            $job_id
        );

        my $job_data =
            get_job($job_id);

        my $job_state =
            $job_data->{job}->{state}
            // 'unknown';

        my $job_result =
            $job_data->{job}->{result};

        $job_results{$job_name} = {
            id     => $job_id,
            state  => $job_state,
            result => $job_result,
        };

        print "\n";
        print "Job finished.\n";
        print "  Name:   $job_name\n";
        print "  ID:     $job_id\n";
        print "  State:  $job_state\n";
        print "  Result: "
            . ($job_result // 'none')
            . "\n";
    }

    #
    # Results
    #

    print "\n";
    print "============================================================\n";
    print "Parallel scenario results\n";
    print "============================================================\n";

    my $failed = 0;

    for my $parallel_job (
        @parallel_jobs
    ) {

        my $job_name =
            $parallel_job->{name};

        my $job_id =
            $job_results{$job_name}->{id};

        my $job_result =
            $job_results{$job_name}->{result};

        if (
            defined $job_result
            && $job_result eq 'passed'
        ) {

            print "  $job_name "
                . "(job $job_id): passed\n";
        }
        else {

            print "  $job_name "
                . "(job $job_id): "
                . ($job_result // 'none')
                . "\n";

            $failed = 1;
        }
    }

    if ($failed) {

        print "\n";
        print "============================================================\n";
        print "PARALLEL SCENARIO FAILED\n";
        print "============================================================\n";

        return;
    }

    print "\n";
    print "============================================================\n";
    print "PARALLEL SCENARIO PASSED\n";
    print "============================================================\n";

    return 1;
}

# ============================================================
# Expand variables
# ============================================================

sub expand_variables {
    my ($value, $job) = @_;

    return $value
        unless defined $value;

    $value =~ s{
        %([A-Z0-9_]+)%
    }{
        exists $job->{$1}
            ? $job->{$1}
            : "%$1%"
    }gex;

    return $value;
}

# ============================================================
# Wait for job
# ============================================================

sub wait_for_job {
    my ($job_id) = @_;

    print "\nWaiting for job $job_id...\n";

    while (1) {

        my $job_data =
            get_job($job_id);

        my $state =
            $job_data->{job}->{state}
            // 'unknown';

        my $result =
            $job_data->{job}->{result};

        if (
            defined $result
            && length $result
        ) {

            print "  Job $job_id: "
                . "state=$state "
                . "result=$result\n";
        }
        else {

            print "  Job $job_id: "
                . "state=$state "
                . "result=none\n";
        }

        last
            if $state eq 'done';

        sleep $opt{poll};
    }
}

# ============================================================
# Get job
# ============================================================

sub get_job {
    my ($job_id) = @_;

    my @command = (
        'openqa-cli',
        'api',
        "jobs/$job_id",
    );

    my $response =
        capture_command(
            @command
        );

    return decode_json(
        $response
    );
}

# ============================================================
# Execute command
# ============================================================

sub capture_command {
    my (@command) = @_;

    open my $fh, '-|', @command
        or die "Failed to execute @command: $!\n";

    local $/;

    my $output =
        <$fh>;

    close $fh;

    if ($? == -1) {

        die "Failed to execute @command: $!\n";
    }

    if ($? & 127) {

        die sprintf(
            "Command terminated by signal %d\n",
            $? & 127
        );
    }

    my $exit_code =
        $? >> 8;

    if ($exit_code != 0) {

        die "Command exited with code $exit_code\n";
    }

    return $output;
}

# ============================================================
# Required option
# ============================================================

sub require_option {
    my ($name) = @_;

    return
        if defined $opt{$name}
        && length $opt{$name};

    die "Missing required option: --$name\n";
}

# ============================================================
# Print job parameters
# ============================================================

sub print_job_parameters {
    my ($job) = @_;

    for my $key (
        sort keys %{$job}
    ) {

        print "  $key=$job->{$key}\n";
    }
}

