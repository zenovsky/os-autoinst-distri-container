#!/usr/bin/env perl

use strict;
use warnings;

use FindBin '$Bin';
use Getopt::Long qw(GetOptions);
use JSON::PP qw(decode_json);

use lib "$Bin/../lib";

use ScenarioLoader;

# ------------------------------------------------------------
# Defaults
# ------------------------------------------------------------

my %opt = (
    host => 'http://localhost',
    poll => 10,
);

# ------------------------------------------------------------
# CLI
# ------------------------------------------------------------

my $scenario_name = shift @ARGV
    // die "Usage: $0 <scenario> [options]\n";

GetOptions(
    'host=s'     => \$opt{host},
    'distri=s'   => \$opt{distri},
    'version=s'  => \$opt{version},
    'build=s'    => \$opt{build},
    'flavor=s'   => \$opt{flavor},
    'arch=s'     => \$opt{arch},
    'machine=s'  => \$opt{machine},
    'iso=s'      => \$opt{iso},
    'iso-url=s'  => \$opt{iso_url},
    'casedir=s'  => \$opt{casedir},
    'hdd=s'      => \$opt{hdd},
    'poll=i'     => \$opt{poll},
    'help'       => \$opt{help},
) or die "Invalid options\n";

if ($opt{help}) {
    print_usage();
    exit 0;
}

die "--poll must be greater than 0\n"
    if $opt{poll} <= 0;

# ------------------------------------------------------------
# Validate common parameters
# ------------------------------------------------------------

require_option('distri');
require_option('version');
require_option('flavor');
require_option('arch');
require_option('machine');
require_option('iso');
require_option('casedir');
require_option('build');

# ------------------------------------------------------------
# Verify
#
# verify is an orchestration scenario:
#
#   create-base-image
#          |
#          +-- passed --> smoke
#                         |
#                         +-- passed --> regression
#
# If any stage fails, the next stage is not started.
# ------------------------------------------------------------

if ($scenario_name eq 'verify') {

    print "\n";
    print "============================================================\n";
    print "VERIFY\n";
    print "============================================================\n";

    # --------------------------------------------------------
    # Stage 1: create-base-image
    # --------------------------------------------------------

    print "\n";
    print "------------------------------------------------------------\n";
    print "Stage 1/3: create-base-image\n";
    print "------------------------------------------------------------\n";

    my $image = run_scenario('create-base-image');

    unless ($image) {
        print "\n";
        print "ERROR: create-base-image did not produce an HDD image.\n";
        print "Smoke and regression will NOT be started.\n";
        exit 1;
    }

    print "\n";
    print "Base image is ready:\n";
    print "  $image\n";

    # --------------------------------------------------------
    # Stage 2: smoke
    # --------------------------------------------------------

    print "\n";
    print "------------------------------------------------------------\n";
    print "Stage 2/3: smoke\n";
    print "------------------------------------------------------------\n";

    my $smoke_result = run_scenario(
        'smoke',
        hdd => $image,
    );

    unless ($smoke_result) {
        print "\n";
        print "ERROR: smoke failed.\n";
        print "Regression will NOT be started.\n";
        exit 1;
    }

    # --------------------------------------------------------
    # Stage 3: regression
    # --------------------------------------------------------

    print "\n";
    print "------------------------------------------------------------\n";
    print "Stage 3/3: regression\n";
    print "------------------------------------------------------------\n";

    my $regression_result = run_scenario(
        'regression',
        hdd => $image,
    );

    unless ($regression_result) {
        print "\n";
        print "ERROR: regression failed.\n";
        exit 1;
    }

    # --------------------------------------------------------
    # Verify success
    # --------------------------------------------------------

    print "\n";
    print "============================================================\n";
    print "VERIFY PASSED\n";
    print "============================================================\n";

    print "\n";
    print "All stages passed:\n";
    print "  create-base-image: passed\n";
    print "  smoke:             passed\n";
    print "  regression:        passed\n";

    exit 0;
}

# ------------------------------------------------------------
# Normal scenario
#
# Existing behavior for:
#
#   create-base-image
#   smoke
#   regression
#
# remains unchanged.
# ------------------------------------------------------------

run_scenario($scenario_name);

exit 0;

# ============================================================
# Run scenario
# ============================================================

sub run_scenario {
    my ($name, %args) = @_;

    my $hdd = $args{hdd};

    # --------------------------------------------------------
    # Load scenario
    # --------------------------------------------------------

    my $loader = ScenarioLoader->new(
        scenario_dir => "$Bin/../scenarios"
    );

    my $scenario = $loader->load($name);

    print "Scenario: $scenario->{name}\n";
    print "Type:     $scenario->{type}\n";

    # --------------------------------------------------------
    # Parallel scenario
    # --------------------------------------------------------

    if ($scenario->{type} eq 'parallel') {
        return run_parallel_scenario(
            $name,
            $scenario,
        );
    }

    # --------------------------------------------------------
    # Prepare job parameters
    # --------------------------------------------------------

    my %job = (
        DISTRI  => $opt{distri},
        VERSION => $opt{version},
        BUILD   => $opt{build},
        FLAVOR  => $opt{flavor},
        ARCH    => $opt{arch},
        MACHINE => $opt{machine},
        BACKEND => 'qemu',
        ISO     => $opt{iso},
        CASEDIR => $opt{casedir},

        TEST     => $name,
        SCENARIO => $name,
    );

    $job{ISO_URL} = $opt{iso_url}
        if defined $opt{iso_url} && length $opt{iso_url};

    # --------------------------------------------------------
    # Add scenario variables
    # --------------------------------------------------------

    for my $key (keys %{$scenario->{variables} // {}}) {
        $job{$key} = $scenario->{variables}{$key};
    }

    # --------------------------------------------------------
    # Expand variables
    #
    # Example:
    #
    #   %DISTRI%-%VERSION%-%ARCH%.qcow2
    #
    # becomes:
    #
    #   os-autoinst-distri-container-10.2-x86_64.qcow2
    # --------------------------------------------------------

    for my $key (keys %job) {
        $job{$key} = expand_variables(
            $job{$key},
            \%job
        );
    }

    # --------------------------------------------------------
    # Image scenario
    # --------------------------------------------------------

    my $expected_image;

    if ($scenario->{type} eq 'image') {

        my $image = $scenario->{image};

        my $image_size = $image->{size_gb};

        $expected_image = expand_variables(
            $image->{name},
            \%job
        );

        print "Image:\n";
        print "  Name: $expected_image\n";
        print "  Size: ${image_size} GB\n";

        $job{HDDSIZEGB} = $image_size;
        $job{PUBLISH_HDD_1} = $expected_image;
    }

    # --------------------------------------------------------
    # Test scenario using an existing HDD
    # --------------------------------------------------------

    elsif ($scenario->{type} eq 'test') {

        if (defined $hdd && length $hdd) {

            $job{BOOT_HDD_IMAGE} = 1;
            $job{HDD_1} = $hdd;

            print "HDD:\n";
            print "  Image: $hdd\n";
        }
    }

    # --------------------------------------------------------
    # Expand variables again
    #
    # This is important because image-specific parameters such
    # as PUBLISH_HDD_1 are added after the first expansion.
    # --------------------------------------------------------

    for my $key (keys %job) {
        $job{$key} = expand_variables(
            $job{$key},
            \%job
        );
    }

    # --------------------------------------------------------
    # Print job parameters
    # --------------------------------------------------------

    print "\nJob parameters:\n";

    for my $key (sort keys %job) {
        print "  $key=$job{$key}\n";
    }

    # --------------------------------------------------------
    # Submit job
    # --------------------------------------------------------

    print "\nStarting openQA job...\n";

    my @command = (
        'openqa-cli',
        'api',
        '-X',
        'POST',
        'jobs',
    );

    for my $key (sort keys %job) {
        push @command, "$key=$job{$key}";
    }

    my $response = capture_command(@command);

    my $data = decode_json($response);

    die "openQA response does not contain job id\n"
        unless exists $data->{id};

    my $job_id = $data->{id};

    print "Job ID: $job_id\n";

    # --------------------------------------------------------
    # Wait for job
    # --------------------------------------------------------

    wait_for_job($job_id);

    # --------------------------------------------------------
    # Get final job information
    # --------------------------------------------------------

    my $job_data = get_job($job_id);

    my $job_result = $job_data->{job}->{result};
    my $job_state  = $job_data->{job}->{state};

    print "\nJob finished.\n";
    print "  ID:     $job_id\n";
    print "  State:  $job_state\n";
    print "  Result: " . ($job_result // 'none') . "\n";

    # --------------------------------------------------------
    # Check result
    # --------------------------------------------------------

    if (!defined $job_result || $job_result ne 'passed') {

        print "\nScenario '$name' failed.\n";

        return;
    }

    # --------------------------------------------------------
    # Check published image
    # --------------------------------------------------------

    if ($scenario->{type} eq 'image') {

        my $hdds = $job_data->{job}->{assets}->{hdd} // [];

        my %published = map {
            $_ => 1
        } @{$hdds};

        unless ($published{$expected_image}) {

            print "\nERROR: Expected HDD was not published:\n";
            print "  $expected_image\n";

            print "\nPublished HDD assets:\n";

            for my $hdd_name (@{$hdds}) {
                print "  $hdd_name\n";
            }

            return;
        }

        print "\nImage successfully created:\n";
        print "  $expected_image\n";

        return $expected_image;
    }

    # --------------------------------------------------------
    # Test scenario passed
    # --------------------------------------------------------

    print "\nScenario '$name' passed.\n";

    return 1;
}

# ============================================================
# Run parallel scenario
# ============================================================

sub run_parallel_scenario {
    my ($name, $scenario) = @_;

    print "\n";
    print "============================================================\n";
    print "PARALLEL SCENARIO: $name\n";
    print "============================================================\n";

    my @parallel_jobs = @{$scenario->{jobs}};

    #
    # Store openQA job IDs by logical job name.
    #
    # Example:
    #
    #   server => 123
    #   client => 124
    #
    my %job_ids;

    # --------------------------------------------------------
    # Start all parallel jobs
    # --------------------------------------------------------

    for my $parallel_job (@parallel_jobs) {

        my $job_name = $parallel_job->{name};

        print "\n";
        print "------------------------------------------------------------\n";
        print "Parallel job: $job_name\n";
        print "------------------------------------------------------------\n";

        # ----------------------------------------------------
        # Prepare base job parameters
        # ----------------------------------------------------

        my %job = (
            DISTRI  => $opt{distri},
            VERSION => $opt{version},
            BUILD   => $opt{build},
            FLAVOR  => $opt{flavor},
            ARCH    => $opt{arch},
            MACHINE => $opt{machine},
            BACKEND => 'qemu',
            ISO     => $opt{iso},
            CASEDIR => $opt{casedir},

            TEST     => $job_name,
            SCENARIO => $name,
        );

        # ----------------------------------------------------
        # Optional ISO URL
        # ----------------------------------------------------

        if (defined $opt{iso_url} && length $opt{iso_url}) {
            $job{ISO_URL} = $opt{iso_url};
        }

        # ----------------------------------------------------
        # Add scenario-wide variables
        #
        # Example:
        #
        #   NICTYPE: tap
        #   QEMUCPU: host
        #   QEMUCPUS: 2
        #   BOOT_HDD_IMAGE: 1
        #   HDD_1: "%DISTRI%-%VERSION%-%BUILD%-%ARCH%.qcow2"
        #
        # ----------------------------------------------------

        for my $key (keys %{$scenario->{variables} // {}}) {

            $job{$key} = $scenario->{variables}{$key};
        }

        # ----------------------------------------------------
        # PARALLEL_WITH
        #
        # Pass the value directly to openQA.
        #
        # Example:
        #
        #   client:
        #       PARALLEL_WITH: server
        #
        # becomes:
        #
        #   PARALLEL_WITH=server
        #
        # ----------------------------------------------------

        if (exists $parallel_job->{PARALLEL_WITH}) {

            $job{PARALLEL_WITH} =
                $parallel_job->{PARALLEL_WITH};
        }

        # ----------------------------------------------------
        # Expand variables
        #
        # Example:
        #
        #   %DISTRI%-%VERSION%-%BUILD%-%ARCH%.qcow2
        #
        # becomes:
        #
        #   os-autoinst-distri-container-10.2-20260818-x86_64.qcow2
        #
        # ----------------------------------------------------

        for my $key (keys %job) {

            $job{$key} = expand_variables(
                $job{$key},
                \%job
            );
        }

        # ----------------------------------------------------
        # If HDD_1 is specified, make sure the job boots
        # from the existing HDD image.
        # ----------------------------------------------------

        if (defined $job{HDD_1} && length $job{HDD_1}) {

            $job{BOOT_HDD_IMAGE} = 1;
        }

        # ----------------------------------------------------
        # Print job parameters
        # ----------------------------------------------------

        print "\n";
        print "Job parameters:\n";

        for my $key (sort keys %job) {

            print "  $key=$job{$key}\n";
        }

        # ----------------------------------------------------
        # Submit job to openQA
        # ----------------------------------------------------

        print "\n";
        print "Starting openQA job '$job_name'...\n";

        my @command = (
            'openqa-cli',
            'api',
            '-X',
            'POST',
            'jobs',
        );

        for my $key (sort keys %job) {

            push @command, "$key=$job{$key}";
        }

        my $response = capture_command(@command);

        my $data = decode_json($response);

        die "openQA response does not contain job id "
            . "for parallel job '$job_name'\n"
            unless exists $data->{id};

        my $job_id = $data->{id};

        $job_ids{$job_name} = $job_id;

        print "Job '$job_name' started.\n";
        print "  Job ID: $job_id\n";

        if (exists $job{PARALLEL_WITH}) {

            print "  PARALLEL_WITH: "
                . "$job{PARALLEL_WITH}\n";
        }
    }

    # --------------------------------------------------------
    # All jobs have now been submitted.
    #
    # This is important: we start EVERY job first and only
    # then wait for their results.
    #
    # openQA itself handles PARALLEL_WITH.
    # --------------------------------------------------------

    print "\n";
    print "============================================================\n";
    print "All parallel jobs started\n";
    print "============================================================\n";

    for my $parallel_job (@parallel_jobs) {

        my $job_name = $parallel_job->{name};
        my $job_id   = $job_ids{$job_name};

        print "  $job_name -> job $job_id\n";
    }

    # --------------------------------------------------------
    # Wait for all jobs
    # --------------------------------------------------------

    my %job_results;

    print "\n";
    print "============================================================\n";
    print "Waiting for parallel jobs\n";
    print "============================================================\n";

    for my $parallel_job (@parallel_jobs) {

        my $job_name = $parallel_job->{name};
        my $job_id   = $job_ids{$job_name};

        print "\n";
        print "Waiting for job '$job_name' "
            . "(ID $job_id)...\n";

        wait_for_job($job_id);

        # ----------------------------------------------------
        # Get final job information
        # ----------------------------------------------------

        my $job_data = get_job($job_id);

        my $job_state =
            $job_data->{job}->{state} // 'unknown';

        my $job_result =
            $job_data->{job}->{result};

        $job_results{$job_name} = {
            id     => $job_id,
            state  => $job_state,
            result => $job_result,
        };

        print "\n";
        print "Job finished.\n";
        print "  Name:   $job_name\n";
        print "  ID:     $job_id\n";
        print "  State:  $job_state\n";
        print "  Result: "
            . ($job_result // 'none')
            . "\n";
    }

    # --------------------------------------------------------
    # Check results
    # --------------------------------------------------------

    print "\n";
    print "============================================================\n";
    print "Parallel scenario results\n";
    print "============================================================\n";

    my $failed = 0;

    for my $parallel_job (@parallel_jobs) {

        my $job_name = $parallel_job->{name};

        my $job_id =
            $job_results{$job_name}->{id};

        my $job_state =
            $job_results{$job_name}->{state};

        my $job_result =
            $job_results{$job_name}->{result};

        if (defined $job_result && $job_result eq 'passed') {

            print "  $job_name "
                . "(job $job_id): passed\n";

        }
        else {

            print "  $job_name "
                . "(job $job_id): "
                . ($job_result // 'none')
                . "\n";

            $failed = 1;
        }
    }

    # --------------------------------------------------------
    # Final result
    # --------------------------------------------------------

    if ($failed) {

        print "\n";
        print "============================================================\n";
        print "PARALLEL SCENARIO FAILED\n";
        print "============================================================\n";

        print "\n";
        print "Scenario '$name' failed.\n";

        return;
    }

    print "\n";
    print "============================================================\n";
    print "PARALLEL SCENARIO PASSED\n";
    print "============================================================\n";

    print "\n";
    print "Scenario '$name' passed.\n";

    return 1;
}

# ============================================================
# Expand variables
# ============================================================

sub expand_variables {
    my ($value, $job) = @_;

    return $value unless defined $value;

    $value =~ s/%([A-Z0-9_]+)%/
        exists $job->{$1}
            ? $job->{$1}
            : "%$1%"
    /ge;

    return $value;
}

# ============================================================
# Wait for job
# ============================================================

sub wait_for_job {
    my ($job_id) = @_;

    print "\nWaiting for job $job_id...\n";

    while (1) {

        my $job_data = get_job($job_id);

        my $state = $job_data->{job}->{state} // 'unknown';
        my $result = $job_data->{job}->{result};

        if (defined $result && length $result) {
            print "  Job $job_id: state=$state result=$result\n";
        }
        else {
            print "  Job $job_id: state=$state result=none\n";
        }

        last if $state eq 'done';

        sleep $opt{poll};
    }
}

# ============================================================
# Get job
# ============================================================

sub get_job {
    my ($job_id) = @_;

    my @command = (
        'openqa-cli',
        'api',
        "jobs/$job_id",
    );

    my $response = capture_command(@command);

    return decode_json($response);
}

# ============================================================
# Execute command and capture output
# ============================================================

sub capture_command {
    my (@command) = @_;

    open my $fh, '-|', @command
        or die "Failed to execute @command: $!\n";

    local $/;

    my $output = <$fh>;

    close $fh;

    if ($? == -1) {
        die "Failed to execute @command: $!\n";
    }

    if ($? & 127) {
        die sprintf(
            "Command terminated by signal %d\n",
            $? & 127
        );
    }

    my $exit_code = $? >> 8;

    if ($exit_code != 0) {
        die "Command exited with code $exit_code\n";
    }

    return $output;
}

# ============================================================
# Required option
# ============================================================

sub require_option {
    my ($name) = @_;

    return if defined $opt{$name} && length $opt{$name};

    die "Missing required option: --$name\n";
}

# ============================================================
# Usage
# ============================================================

sub print_usage {
    print <<"USAGE";
Usage:

  $0 <scenario> [options]

Scenarios:

  create-base-image
      Create base HDD image from ISO.

  smoke
      Run smoke tests using an existing HDD.

  regression
      Run regression tests using an existing HDD.

  verify
      Create base image, then run smoke and regression.
      If any stage fails, the following stages are skipped.

Required options:

  --distri NAME
  --version VERSION
  --build BUILD
  --flavor FLAVOR
  --arch ARCH
  --machine MACHINE
  --iso ISO
  --casedir PATH

Optional:

  --host URL
  --hdd IMAGE
  --poll SECONDS
  --help

Examples:

Create base image:

  $0 create-base-image \\
      --distri os-autoinst-distri-container \\
      --version 10.2 \\
      --build 20260818 \\
      --flavor Minimal \\
      --arch x86_64 \\
      --machine 64bit \\
      --iso AlmaLinux-10.2-x86_64-minimal.iso \\
      --casedir /var/lib/openqa/tests/os-autoinst-distri-container

Run smoke using existing HDD:

  $0 smoke \\
      --distri os-autoinst-distri-container \\
      --version 10.2 \\
      --build 20260818 \\
      --flavor Minimal \\
      --arch x86_64 \\
      --machine 64bit \\
      --iso AlmaLinux-10.2-x86_64-minimal.iso \\
      --casedir /var/lib/openqa/tests/os-autoinst-distri-container \\
      --hdd os-autoinst-distri-container-10.2-x86_64.qcow2

Run full verification:

  $0 verify \\
      --distri os-autoinst-distri-container \\
      --version 10.2 \\
      --build 20260818 \\
      --flavor Minimal \\
      --arch x86_64 \\
      --machine 64bit \\
      --iso AlmaLinux-10.2-x86_64-minimal.iso \\
      --casedir /var/lib/openqa/tests/os-autoinst-distri-container

USAGE
}