#!/usr/bin/env perl

use strict;
use warnings;

use FindBin '$Bin';
use Getopt::Long qw(GetOptions);
use JSON::PP qw(decode_json);

use lib "$Bin/../lib";

use ScenarioLoader;

# ------------------------------------------------------------
# Defaults
# ------------------------------------------------------------

my %opt = (
    host => 'http://localhost',
    poll => 10,
);

# ------------------------------------------------------------
# CLI
# ------------------------------------------------------------

my $scenario_name = shift @ARGV
    // die "Usage: $0 <scenario> [options]\n";

GetOptions(
    'host=s'     => \$opt{host},
    'distri=s'   => \$opt{distri},
    'version=s'  => \$opt{version},
    'build=s'    => \$opt{build},
    'flavor=s'   => \$opt{flavor},
    'arch=s'     => \$opt{arch},
    'machine=s'  => \$opt{machine},
    'iso=s'      => \$opt{iso},
    'iso-url=s'  => \$opt{iso_url},
    'casedir=s'  => \$opt{casedir},
    'hdd=s'      => \$opt{hdd},
    'poll=i'     => \$opt{poll},
    'help'       => \$opt{help},
) or die "Invalid options\n";

if ($opt{help}) {
    print_usage();
    exit 0;
}

die "--poll must be greater than 0\n"
    if $opt{poll} <= 0;

# ------------------------------------------------------------
# Validate common parameters
# ------------------------------------------------------------

require_option('distri');
require_option('version');
require_option('flavor');
require_option('arch');
require_option('machine');
require_option('iso');
require_option('casedir');
require_option('build');

# ------------------------------------------------------------
# VERIFY
#
# create-base-image
#        |
#        +-- passed --> smoke
#                         |
#                         +-- passed --> regression
# ------------------------------------------------------------

if ($scenario_name eq 'verify') {

    print "\n";
    print "============================================================\n";
    print "VERIFY\n";
    print "============================================================\n";

    # --------------------------------------------------------
    # Stage 1
    # --------------------------------------------------------

    print "\n";
    print "------------------------------------------------------------\n";
    print "Stage 1/3: create-base-image\n";
    print "------------------------------------------------------------\n";

    my $image = run_scenario('create-base-image');

    unless ($image) {
        print "\n";
        print "ERROR: create-base-image did not produce an HDD image.\n";
        print "Smoke and regression will NOT be started.\n";
        exit 1;
    }

    print "\n";
    print "Base image is ready:\n";
    print "  $image\n";

    # --------------------------------------------------------
    # Stage 2
    # --------------------------------------------------------

    print "\n";
    print "------------------------------------------------------------\n";
    print "Stage 2/3: smoke\n";
    print "------------------------------------------------------------\n";

    my $smoke_result = run_scenario(
        'smoke',
        hdd => $image,
    );

    unless ($smoke_result) {
        print "\n";
        print "ERROR: smoke failed.\n";
        print "Regression will NOT be started.\n";
        exit 1;
    }

    # --------------------------------------------------------
    # Stage 3
    # --------------------------------------------------------

    print "\n";
    print "------------------------------------------------------------\n";
    print "Stage 3/3: regression\n";
    print "------------------------------------------------------------\n";

    my $regression_result = run_scenario(
        'regression',
        hdd => $image,
    );

    unless ($regression_result) {
        print "\n";
        print "ERROR: regression failed.\n";
        exit 1;
    }

    # --------------------------------------------------------
    # Success
    # --------------------------------------------------------

    print "\n";
    print "============================================================\n";
    print "VERIFY PASSED\n";
    print "============================================================\n";

    print "\n";
    print "All stages passed:\n";
    print "  create-base-image: passed\n";
    print "  smoke:             passed\n";
    print "  regression:        passed\n";

    exit 0;
}

# ------------------------------------------------------------
# Normal scenario
# ------------------------------------------------------------

run_scenario($scenario_name);

exit 0;

# ============================================================
# Run scenario
# ============================================================

sub run_scenario {
    my ($name, %args) = @_;

    my $hdd = $args{hdd};

    # --------------------------------------------------------
    # Load scenario
    # --------------------------------------------------------

    my $loader = ScenarioLoader->new(
        scenario_dir => "$Bin/../scenarios"
    );

    my $scenario = $loader->load($name);

    print "Scenario: $scenario->{name}\n";
    print "Type:     $scenario->{type}\n";

    # --------------------------------------------------------
    # Parallel scenario
    # --------------------------------------------------------

    if ($scenario->{type} eq 'parallel') {

        return run_parallel_scenario(
            $name,
            $scenario,
        );
    }

    # --------------------------------------------------------
    # Prepare job
    # --------------------------------------------------------

    my %job = (
        DISTRI  => $opt{distri},
        VERSION => $opt{version},
        BUILD   => $opt{build},
        FLAVOR  => $opt{flavor},
        ARCH    => $opt{arch},
        MACHINE => $opt{machine},
        BACKEND => 'qemu',
        ISO     => $opt{iso},
        CASEDIR => $opt{casedir},

        TEST     => $name,
        SCENARIO => $name,
    );

    # --------------------------------------------------------
    # Optional ISO URL
    # --------------------------------------------------------

    if (defined $opt{iso_url} && length $opt{iso_url}) {
        $job{ISO_URL} = $opt{iso_url};
    }

    # --------------------------------------------------------
    # Scenario variables
    # --------------------------------------------------------

    for my $key (keys %{$scenario->{variables} // {}}) {

        $job{$key} = $scenario->{variables}{$key};
    }

    # --------------------------------------------------------
    # Expand variables
    # --------------------------------------------------------

    for my $key (keys %job) {

        $job{$key} = expand_variables(
            $job{$key},
            \%job
        );
    }

    # --------------------------------------------------------
    # Image scenario
    # --------------------------------------------------------

    my $expected_image;

    if ($scenario->{type} eq 'image') {

        my $image = $scenario->{image};

        my $image_size = $image->{size_gb};

        $expected_image = expand_variables(
            $image->{name},
            \%job
        );

        print "Image:\n";
        print "  Name: $expected_image\n";
        print "  Size: ${image_size} GB\n";

        $job{HDDSIZEGB}    = $image_size;
        $job{PUBLISH_HDD_1} = $expected_image;
    }

    # --------------------------------------------------------
    # Test scenario using existing HDD
    # --------------------------------------------------------

    elsif ($scenario->{type} eq 'test') {

        if (defined $hdd && length $hdd) {

            $job{BOOT_HDD_IMAGE} = 1;
            $job{HDD_1} = $hdd;

            print "HDD:\n";
            print "  Image: $hdd\n";
        }
    }

    # --------------------------------------------------------
    # Expand again
    # --------------------------------------------------------

    for my $key (keys %job) {

        $job{$key} = expand_variables(
            $job{$key},
            \%job
        );
    }

    # --------------------------------------------------------
    # Print parameters
    # --------------------------------------------------------

    print "\nJob parameters:\n";

    for my $key (sort keys %job) {

        print "  $key=$job{$key}\n";
    }

    # --------------------------------------------------------
    # Submit
    # --------------------------------------------------------

    print "\nStarting openQA job...\n";

    my @command = (
        'openqa-cli',
        'api',
        '-X',
        'POST',
        'jobs',
    );

    for my $key (sort keys %job) {

        push @command, "$key=$job{$key}";
    }

    my $response = capture_command(@command);

    my $data = decode_json($response);

    die "openQA response does not contain job id\n"
        unless exists $data->{id};

    my $job_id = $data->{id};

    print "Job ID: $job_id\n";

    # --------------------------------------------------------
    # Wait
    # --------------------------------------------------------

    wait_for_job($job_id);

    # --------------------------------------------------------
    # Final information
    # --------------------------------------------------------

    my $job_data = get_job($job_id);

    my $job_result =
        $job_data->{job}->{result};

    my $job_state =
        $job_data->{job}->{state};

    print "\nJob finished.\n";
    print "  ID:     $job_id\n";
    print "  State:  $job_state\n";
    print "  Result: "
        . ($job_result // 'none')
        . "\n";

    # --------------------------------------------------------
    # Result
    # --------------------------------------------------------

    if (!defined $job_result || $job_result ne 'passed') {

        print "\nScenario '$name' failed.\n";

        return;
    }

    # --------------------------------------------------------
    # Check published image
    # --------------------------------------------------------

    if ($scenario->{type} eq 'image') {

        my $hdds =
            $job_data->{job}->{assets}->{hdd} // [];

        my %published = map {
            $_ => 1
        } @{$hdds};

        unless ($published{$expected_image}) {

            print "\nERROR: Expected HDD was not published:\n";
            print "  $expected_image\n";

            print "\nPublished HDD assets:\n";

            for my $hdd_name (@{$hdds}) {

                print "  $hdd_name\n";
            }

            return;
        }

        print "\nImage successfully created:\n";
        print "  $expected_image\n";

        return $expected_image;
    }

    # --------------------------------------------------------
    # Test passed
    # --------------------------------------------------------

    print "\nScenario '$name' passed.\n";

    return 1;
}

# ============================================================
# Run parallel scenario
# ============================================================

# ============================================================
# Run parallel scenario
# ============================================================

sub run_parallel_scenario {
    my ($name, $scenario) = @_;

    print "\n";
    print "============================================================\n";
    print "PARALLEL SCENARIO: $name\n";
    print "============================================================\n";

    my @parallel_jobs = @{$scenario->{jobs}};

    #
    # Map logical job names to indexes.
    #
    # server -> 0
    # client -> 1
    #
    my %job_index;

    for my $index (0 .. $#parallel_jobs) {
        $job_index{$parallel_jobs[$index]->{name}} = $index;
    }

    # --------------------------------------------------------
    # Prepare common parameters
    # --------------------------------------------------------

    my %common_job = (
        DISTRI  => $opt{distri},
        VERSION => $opt{version},
        BUILD   => $opt{build},
        FLAVOR  => $opt{flavor},
        ARCH    => $opt{arch},
        MACHINE => $opt{machine},
        BACKEND => 'qemu',
        ISO     => $opt{iso},
        CASEDIR => $opt{casedir},

        SCENARIO => $name,
    );

    # --------------------------------------------------------
    # Optional ISO URL
    # --------------------------------------------------------

    if (defined $opt{iso_url} && length $opt{iso_url}) {
        $common_job{ISO_URL} = $opt{iso_url};
    }

    # --------------------------------------------------------
    # Add scenario variables
    # --------------------------------------------------------

    for my $key (keys %{$scenario->{variables} // {}}) {
        $common_job{$key} = $scenario->{variables}{$key};
    }

    # --------------------------------------------------------
    # Expand variables
    # --------------------------------------------------------

    for my $key (keys %common_job) {
        $common_job{$key} = expand_variables(
            $common_job{$key},
            \%common_job
        );
    }

    # --------------------------------------------------------
    # Build ONE openQA request
    # --------------------------------------------------------

    my @command = (
        'openqa-cli',
        'api',
        '-X',
        'POST',
        'jobs',
    );

    for my $index (0 .. $#parallel_jobs) {

        my $parallel_job = $parallel_jobs[$index];
        my $job_name     = $parallel_job->{name};

        print "\n";
        print "------------------------------------------------------------\n";
        print "Parallel job [$index]: $job_name\n";
        print "------------------------------------------------------------\n";

        push @command,
            "TEST:$index=$job_name";

        print "  TEST:$index=$job_name\n";

        # ----------------------------------------------------
        # PARALLEL_WITH
        #
        # Convert logical name:
        #
        #   PARALLEL_WITH: server
        #
        # into openQA job index:
        #
        #   PARALLEL_WITH:1=0
        # ----------------------------------------------------

        if (exists $parallel_job->{PARALLEL_WITH}) {

            my $target_name =
                $parallel_job->{PARALLEL_WITH};

            die "Parallel job '$job_name' references "
                . "unknown job '$target_name'\n"
                unless exists $job_index{$target_name};

            my $target_index =
                $job_index{$target_name};

            push @command,
                "PARALLEL_WITH:$index=$target_index";

            print "  PARALLEL_WITH:$index=$target_index\n";
        }
    }

    # --------------------------------------------------------
    # Add common parameters
    # --------------------------------------------------------

    for my $key (sort keys %common_job) {

        push @command,
            "$key=$common_job{$key}";
    }

    # --------------------------------------------------------
    # Existing HDD
    #
    # For network scenario we need the base image.
    # --------------------------------------------------------

    if (exists $scenario->{variables}->{HDD_1}) {

        my $hdd = expand_variables(
            $scenario->{variables}->{HDD_1},
            \%common_job
        );

        push @command, "HDD_1=$hdd";
        push @command, "BOOT_HDD_IMAGE=1";
    }

    # --------------------------------------------------------
    # Print command parameters
    # --------------------------------------------------------

    print "\n";
    print "============================================================\n";
    print "Submitting ALL parallel jobs in ONE request\n";
    print "============================================================\n";

    print "\nCommand parameters:\n";

    for my $arg (@command[5 .. $#command]) {
        print "  $arg\n";
    }

    # --------------------------------------------------------
    # Submit ONE request
    # --------------------------------------------------------

    print "\n";
    print "Starting parallel jobs...\n";

    my $response = capture_command(@command);

    print "\nopenQA response:\n";
    print $response;

    my $data = decode_json($response);

    die "openQA response does not contain job IDs\n"
        unless exists $data->{ids}
        && ref($data->{ids}) eq 'HASH';

    # --------------------------------------------------------
    # Save returned job IDs
    # --------------------------------------------------------

    my %job_ids;

    for my $index (keys %{$data->{ids}}) {

        my $job_id = $data->{ids}{$index};

        die "Invalid job index returned by openQA: $index\n"
            unless exists $parallel_jobs[$index];

        my $job_name =
            $parallel_jobs[$index]->{name};

        $job_ids{$job_name} = $job_id;

        print "  $job_name -> job $job_id\n";
    }

    # --------------------------------------------------------
    # Make sure every requested job was created
    # --------------------------------------------------------

    for my $index (0 .. $#parallel_jobs) {

        my $job_name =
            $parallel_jobs[$index]->{name};

        die "openQA did not return job ID for "
            . "'$job_name'\n"
            unless exists $job_ids{$job_name};
    }

    # --------------------------------------------------------
    # Wait for all jobs
    # --------------------------------------------------------

    my %job_results;

    print "\n";
    print "============================================================\n";
    print "Waiting for parallel jobs\n";
    print "============================================================\n";

    for my $parallel_job (@parallel_jobs) {

        my $job_name =
            $parallel_job->{name};

        my $job_id =
            $job_ids{$job_name};

        print "\n";
        print "Waiting for job '$job_name' "
            . "(ID $job_id)...\n";

        wait_for_job($job_id);

        my $job_data =
            get_job($job_id);

        my $job_state =
            $job_data->{job}->{state} // 'unknown';

        my $job_result =
            $job_data->{job}->{result};

        $job_results{$job_name} = {
            id     => $job_id,
            state  => $job_state,
            result => $job_result,
        };

        print "\n";
        print "Job finished.\n";
        print "  Name:   $job_name\n";
        print "  ID:     $job_id\n";
        print "  State:  $job_state\n";
        print "  Result: "
            . ($job_result // 'none')
            . "\n";
    }

    # --------------------------------------------------------
    # Check results
    # --------------------------------------------------------

    print "\n";
    print "============================================================\n";
    print "Parallel scenario results\n";
    print "============================================================\n";

    my $failed = 0;

    for my $parallel_job (@parallel_jobs) {

        my $job_name =
            $parallel_job->{name};

        my $job_id =
            $job_results{$job_name}->{id};

        my $job_result =
            $job_results{$job_name}->{result};

        if (defined $job_result && $job_result eq 'passed') {

            print "  $job_name "
                . "(job $job_id): passed\n";
        }
        else {

            print "  $job_name "
                . "(job $job_id): "
                . ($job_result // 'none')
                . "\n";

            $failed = 1;
        }
    }

    # --------------------------------------------------------
    # Final result
    # --------------------------------------------------------

    if ($failed) {

        print "\n";
        print "============================================================\n";
        print "PARALLEL SCENARIO FAILED\n";
        print "============================================================\n";

        print "\n";
        print "Scenario '$name' failed.\n";

        return;
    }

    print "\n";
    print "============================================================\n";
    print "PARALLEL SCENARIO PASSED\n";
    print "============================================================\n";

    print "\n";
    print "Scenario '$name' passed.\n";

    return 1;
}

# ============================================================
# Expand variables
# ============================================================

sub expand_variables {
    my ($value, $job) = @_;

    return $value unless defined $value;

    $value =~ s/%([A-Z0-9_]+)%/
        exists $job->{$1}
            ? $job->{$1}
            : "%$1%"
    /ge;

    return $value;
}

# ============================================================
# Wait for job
# ============================================================

sub wait_for_job {
    my ($job_id) = @_;

    print "\nWaiting for job $job_id...\n";

    while (1) {

        my $job_data = get_job($job_id);

        my $state =
            $job_data->{job}->{state} // 'unknown';

        my $result =
            $job_data->{job}->{result};

        if (defined $result && length $result) {

            print "  Job $job_id: "
                . "state=$state "
                . "result=$result\n";
        }
        else {

            print "  Job $job_id: "
                . "state=$state "
                . "result=none\n";
        }

        last if $state eq 'done';

        sleep $opt{poll};
    }
}

# ============================================================
# Get job
# ============================================================

sub get_job {
    my ($job_id) = @_;

    my @command = (
        'openqa-cli',
        'api',
        "jobs/$job_id",
    );

    my $response =
        capture_command(@command);

    return decode_json($response);
}

# ============================================================
# Execute command
# ============================================================

sub capture_command {
    my (@command) = @_;

    open my $fh, '-|', @command
        or die "Failed to execute @command: $!\n";

    local $/;

    my $output = <$fh>;

    close $fh;

    if ($? == -1) {

        die "Failed to execute @command: $!\n";
    }

    if ($? & 127) {

        die sprintf(
            "Command terminated by signal %d\n",
            $? & 127
        );
    }

    my $exit_code = $? >> 8;

    if ($exit_code != 0) {

        die "Command exited with code $exit_code\n";
    }

    return $output;
}

# ============================================================
# Required option
# ============================================================

sub require_option {
    my ($name) = @_;

    return
        if defined $opt{$name}
        && length $opt{$name};

    die "Missing required option: --$name\n";
}

# ============================================================
# Usage
# ============================================================

sub print_usage {
    print <<"USAGE";
Usage:

  $0 <scenario> [options]

Scenarios:

  create-base-image
      Create base HDD image from ISO.

  smoke
      Run smoke tests using an existing HDD.

  regression
      Run regression tests using an existing HDD.

  verify
      Create base image, then run smoke and regression.

  network
      Run server/client tests in parallel.

Required options:

  --distri NAME
  --version VERSION
  --build BUILD
  --flavor FLAVOR
  --arch ARCH
  --machine MACHINE
  --iso ISO
  --casedir PATH

Optional:

  --host URL
  --iso-url URL
  --hdd IMAGE
  --poll SECONDS
  --help

USAGE
}