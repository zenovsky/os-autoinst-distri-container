#!/usr/bin/perl

use strict;
use warnings;

use FindBin '$Bin';
use lib "$Bin/../lib";

use ScenarioLoader;

my $scenario_name = shift @ARGV;

die "Usage: $0 <scenario-name>\n"
    unless defined $scenario_name && length $scenario_name;

my $loader = ScenarioLoader->new(
    scenario_dir => "$Bin/../scenarios"
);

my $scenario = $loader->load($scenario_name);

print "Name: $scenario->{name}\n";
print "Type: $scenario->{type}\n";

print "\nTests:\n";

for my $test (@{$scenario->{tests} // []}) {
    print "  - $test\n";
}

if (exists $scenario->{variables}) {
    print "\nVariables:\n";

    for my $key (sort keys %{$scenario->{variables}}) {
        my $value = $scenario->{variables}{$key};

        print "  $key=$value\n";
    }
}

if ($scenario->{type} eq 'image') {
    print "\nImage:\n";

    if (exists $scenario->{image}) {
        my $image = $scenario->{image};

        print "  Size: "
            . ($image->{size_gb} // '<not set>')
            . " GB\n";

        print "  Name: "
            . ($image->{name} // '<not set>')
            . "\n";
    }
    else {
        print "  <image definition not set>\n";
    }

    if (exists $scenario->{source}) {
        print "\nSource:\n";

        print "  Scenario: "
            . ($scenario->{source}->{scenario} // '<not set>')
            . "\n";
    }
}