#!/usr/bin/env bash
set -euo pipefail

usage() { echo "Usage: $0 --name <testsuite-name>"; exit 1; }

NAME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -z "$NAME" ]] && usage

existing_id=$(openqa-cli api test_suites \
  | jq -r --arg n "$NAME" '.TestSuites[] | select(.name==$n) | .id' | head -n1)

if [[ -n "$existing_id" ]]; then
  echo "[skip] test suite '$NAME' already exists (id=$existing_id)"
  exit 0
fi

echo "[create] test suite '$NAME'"
openqa-cli api -X POST test_suites --json --data "{\"name\":\"$NAME\"}"