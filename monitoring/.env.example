# Скопируйте в .env и задайте свои значения. Файл .env в git не коммитится.
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-please
# Токен с правами записи/чтения в бакет; тот же токен пойдёт в GitLab (INFLUX_TOKEN).
# Сгенерировать: openssl rand -hex 32
INFLUX_TOKEN=change-me-to-a-long-random-string
INFLUX_ORG=openqa
INFLUX_BUCKET=openqa
INFLUX_RETENTION=0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-too
