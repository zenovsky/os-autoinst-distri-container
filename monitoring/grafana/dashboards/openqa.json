      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"duration_s\")\n  |> group(columns: [\"scenario\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
