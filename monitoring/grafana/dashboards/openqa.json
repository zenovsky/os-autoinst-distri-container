    {
      "id": 8,
      "type": "timeseries",
      "title": "Длительность шагов",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
