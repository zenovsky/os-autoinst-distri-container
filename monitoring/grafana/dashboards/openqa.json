          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_step\")\n  |> filter(fn: (r) => contains(value: r.suite, set: ${suite:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"duration_s\")\n  |> group(columns: [\"suite\", \"step\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
