      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"duration_s\")\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Результаты по дням",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"job_id\")\n  |> group(columns: [\"result\"])\n  |> aggregateWindow(every: 1d, fn: count, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 80
          },
          "displayName": "${__field.labels.result}"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "passed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Стабильность по дням (доля успешных)",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"job_id\")\n  |> map(fn: (r) => ({r with _value: if r.result == \"passed\" or r.result == \"softfailed\" then 1.0 else 0.0}))\n  |> group()\n  |> aggregateWindow(every: 1d, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "always"
          },
          "displayName": "успешные"
        },
        "overrides": []
      }
    },
