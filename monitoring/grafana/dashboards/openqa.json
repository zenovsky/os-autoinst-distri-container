{
  "uid": "openqa-overview",
  "title": "openQA: тесты и стабильность",
  "tags": [
    "openqa",
    "ci"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "scenario",
        "label": "Сценарий (job)",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "openqa-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"openqa\", tag: \"scenario\", start: -90d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"openqa\", tag: \"scenario\", start: -90d)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "suite",
        "label": "Набор шагов (suite)",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "openqa-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"openqa\", tag: \"suite\", start: -90d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"openqa\", tag: \"suite\", start: -90d)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "branch",
        "label": "Ветка",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "openqa-influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"openqa\", tag: \"branch\", start: -90d)",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"openqa\", tag: \"branch\", start: -90d)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Успешность прогонов",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"job_id\")\n  |> map(fn: (r) => ({r with _value: if r.result == \"passed\" or r.result == \"softfailed\" then 1.0 else 0.0}))\n  |> group()\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "description": "Доля job'ов с результатом passed/softfailed за выбранный период."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Всего прогонов",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
