          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"job_id\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Упавших прогонов",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"job_id\" and r.result != \"passed\" and r.result != \"softfailed\")\n  |> group()\n  |> count()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
