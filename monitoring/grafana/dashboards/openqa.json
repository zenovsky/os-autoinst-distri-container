        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Флаки: шаги, которые то проходят, то падают",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_step\")\n  |> filter(fn: (r) => contains(value: r.suite, set: ${suite:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"failed\")\n  |> group(columns: [\"suite\", \"step\"])\n  |> reduce(identity: {runs: 0, fails: 0}, fn: (r, accumulator) => ({runs: accumulator.runs + 1, fails: accumulator.fails + r._value}))\n  |> map(fn: (r) => ({r with fail_rate: float(v: r.fails) / float(v: r.runs)}))\n  |> filter(fn: (r) => r.fail_rate > 0.0 and r.fail_rate < 1.0)\n  |> group()\n  |> sort(columns: [\"fail_rate\"], desc: true)\n  |> keep(columns: [\"suite\", \"step\", \"runs\", \"fails\", \"fail_rate\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fail_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "description": "Шаг считается нестабильным, если за период он и падал, и проходил (доля падений строго между 0 и 100%)."
    },
    {
      "id": 10,
      "type": "table",
      "title": "Чаще всего падающие шаги",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_step\")\n  |> filter(fn: (r) => contains(value: r.suite, set: ${suite:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"failed\")\n  |> group(columns: [\"suite\", \"step\"])\n  |> sum()\n  |> filter(fn: (r) => r._value > 0)\n  |> group()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 10)\n  |> keep(columns: [\"suite\", \"step\", \"_value\"])\n  |> rename(columns: {_value: \"падений\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Самые долгие шаги (среднее)",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_step\")\n  |> filter(fn: (r) => contains(value: r.suite, set: ${suite:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> filter(fn: (r) => r._field == \"duration_s\")\n  |> group(columns: [\"suite\", \"step\"])\n  |> mean()\n  |> group()\n  |> sort(columns: [\"_value\"], desc: true)\n  |> limit(n: 10)\n  |> keep(columns: [\"suite\", \"step\", \"_value\"])\n  |> rename(columns: {_value: \"сек\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Последние прогоны",
      "datasource": {
        "type": "influxdb",
        "uid": "openqa-influx"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "openqa-influx"
          },
          "query": "from(bucket: \"openqa\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"openqa_job\")\n  |> filter(fn: (r) => contains(value: r.scenario, set: ${scenario:json}) and contains(value: r.branch, set: ${branch:json}))\n  |> pivot(rowKey: [\"_time\", \"scenario\", \"result\", \"branch\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 20)\n  |> keep(columns: [\"_time\", \"scenario\", \"result\", \"branch\", \"duration_s\", \"commit\", \"pipeline_id\", \"gitlab_url\", \"openqa_url\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "duration_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "openqa_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Открыть в openQA",
                    "url": "${__value.text}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gitlab_url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Открыть в GitLab",
                    "url": "${__value.text}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "passed": {
                        "color": "green",
                        "index": 0
                      },
                      "softfailed": {
                        "color": "yellow",
                        "index": 1
                      },
                      "failed": {
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    }
  ]
